# ============================================================
# DK Electric Help — Environment Variables
# Copie este arquivo para .env e preencha os valores
# ============================================================

# Flask
SECRET_KEY=substitua-por-uma-chave-segura-aleatoria
FLASK_ENV=production

# Database (Render injeta DATABASE_URL automaticamente)
# Local: sqlite:///dk_electric.db
# Render (PostgreSQL): postgres://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///dk_electric.db

# Base URL da aplicacao (Render injeta automaticamente)
BASE_URL=https://sistema.dkelectric.com.br

# ============================================================
# Dados da Empresa
# ============================================================
COMPANY_NAME=DK Electric Help
COMPANY_PHONE=(19) 99624-5413
COMPANY_EMAIL=Dkeletrichelp@gmail.com
COMPANY_CNPJ=62.400.020/0001-07

# ============================================================
# Orcamentos
# ============================================================
PROPOSAL_VALIDITY_DAYS=15
PDF_OUTPUT_DIR=pdf_output

# ============================================================
# Admin — Login do Painel Administrativo
# ============================================================
ADMIN_EMAIL=Dkelectrichelp@gmail.com
ADMIN_PASSWORD=Deedks123@

# ============================================================
# WhatsApp — Numero que recebe notificacoes de agendamento
# Formato: codigo do pais + DDD + numero (sem espacos ou simbolos)
# ============================================================
WHATSAPP_NOTIFY=5519996245413

# ============================================================
# Meta Cloud API (WhatsApp Business)
# ============================================================
META_WHATSAPP_TOKEN=seu_token_aqui
META_WHATSAPP_PHONE_ID=seu_phone_id_aqui
